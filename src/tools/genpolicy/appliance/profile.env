PROFILE_NAME=k8s-1.33.13-containerd-1.7.29
KUBERNETES_VERSION=v1.33.13
CONTAINERD_VERSION=v1.7.29
RUNC_VERSION=v1.2.8
ETCD_VERSION=v3.5.21
CNI_PLUGINS_VERSION=v1.7.1
PAUSE_IMAGE=genpolicy.local:5000/pause:3.10
NODE_NAME=genpolicy-node
LOCAL_REGISTRY=genpolicy.local:5000
GENPOLICY_EMPTYDIR_MODE=shared-fs
GENPOLICY_BLOCK_DRIVER=virtio-blk-pci
# Directory of per-image snapshotter mounts (<digest>.mounts / <digest>.json)
# used to capture the Kata rootfs_mounts (e.g. multi-layer erofs). Empty by
# default; set it to enable audit-only rootfs prediction. Requires the erofs
# rootfs to be modeled with a virtio-blk-mmio deployment (see the predictor
# README's pci_path gap).
GENPOLICY_ROOTFS_MOUNTS_DIR=
